# Server
API_PORT=8080
READ_TIMEOUT=15
WRITE_TIMEOUT=15
IDLE_TIMEOUT=60
LOG_LEVEL=info

# Feature flags
REDIS_ENABLED=false
S3_ENABLED=false

# Authentication type
AUTHENTICATION_TYPE=zitadel|bearer

# Auth — used when AUTHENTICATION_TYPE=bearer
API_TOKEN=

# Zitadel OIDC — used when AUTHENTICATION_TYPE=zitadel
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_AUDIENCE=image-api

# Redis — used when REDIS_ENABLED=true
REDIS_URL=redis:6379
REDIS_PASSWORD=

# S3 / MinIO — used when S3_ENABLED=true
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=image-processor
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=false

# Worker pool
MAX_WORKERS=10
MAX_QUEUE_DEPTH=50
PROCESSING_TIMEOUT=10

# How long to keep retrying Redis/S3 at startup before running degraded.
# Matters under Docker Swarm, which has no startup ordering. 0 = single attempt.
DEPENDENCY_WAIT_TIMEOUT=60
